<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- Offshore atmosphere: blue sky with sun/cloud rendering via
         Gazebo Classic's SkyX system (time=10 gives a bright daytime
         sky, not sunrise/sunset colors), plus a lighter ambient/
         background than the old indoor-gray defaults so the scene
         actually reads as "outdoors" rather than a lab. -->
    <scene>
      <ambient>0.6 0.65 0.7 1</ambient>
      <background>0.4 0.6 0.85 1</background>
      <shadows>true</shadows>
      <sky>
        <time>10</time>
        <sunrise>6</sunrise>
        <sunset>20</sunset>
        <clouds>
          <speed>0.6</speed>
        </clouds>
      </sky>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Sea surface: a large, flat, blue-colored static plane well below
         the blade, standing in for open water beneath an offshore turbine.
         Real ocean wave simulation is out of scope here; this is a visual
         backdrop, not a hydrodynamics model. Still has collision, so it
         acts as a safety net if the robot ever falls off the blade rather
         than falling forever. -->
    <model name="sea">
      <static>true</static>
      <pose>0 0 -8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.25 0.45 1</ambient>
            <diffuse>0.05 0.35 0.6 1</diffuse>
            <specular>0.3 0.4 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Representative wind turbine blade segment: a procedurally
         generated, tapered, twisted, airfoil-cross-section mesh (root
         chord 1.2m, tip chord 0.35m, 4m span). Scaled for a robot-scale
         demo, not a literal full-size blade (real offshore blades run
         50-100m). Robot spawns near the root (wide end), where there's
         enough chord width for it to stand; the taper toward the tip is
         intentional; narrowing surface width along a blade's span is a
         genuine part of the inspection problem, not just decoration. -->
    <model name="blade">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file:///home/diego/assembly_with_links/install/assembly_with_links/share/assembly_with_links/meshes/blade.stl</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/diego/assembly_with_links/install/assembly_with_links/share/assembly_with_links/meshes/blade.stl</uri>
              <scale>2.5 2.5 2.5</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.87 1</ambient>
            <diffuse>0.9 0.9 0.92 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <!-- Default solver settings are often too loose once you have rigid
           attachment constraints coexisting with actively-driven PID
           joints; that combination is a common source of jitter. More
           iterations means better constraint convergence per step;
           erp/cfm soften the constraints slightly rather than solving
           them as infinitely stiff, which tends to damp out
           high-frequency buzz. -->
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Six independent link-attacher plugin instances, one per leg, each
         its own namespace/internal state; needed since a tripod gait
         always has three legs attached at once. -->
    <plugin name="link_attacher_leg1" filename="libhexapod_link_attacher.so">
      <namespace>/leg1</namespace>
    </plugin>
    <plugin name="link_attacher_leg2" filename="libhexapod_link_attacher.so">
      <namespace>/leg2</namespace>
    </plugin>
    <plugin name="link_attacher_leg3" filename="libhexapod_link_attacher.so">
      <namespace>/leg3</namespace>
    </plugin>
    <plugin name="link_attacher_leg4" filename="libhexapod_link_attacher.so">
      <namespace>/leg4</namespace>
    </plugin>
    <plugin name="link_attacher_leg5" filename="libhexapod_link_attacher.so">
      <namespace>/leg5</namespace>
    </plugin>
    <plugin name="link_attacher_leg6" filename="libhexapod_link_attacher.so">
      <namespace>/leg6</namespace>
    </plugin>

  </world>
</sdf>
