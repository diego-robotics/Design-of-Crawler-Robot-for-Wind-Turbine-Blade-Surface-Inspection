  <!-- Suction cup adhesion is handled entirely by six independent
       hexapod_link_attacher plugin instances declared in
       crawler_hexapod.world (world-level plugins, not per-link URDF
       blocks like vacuum_gripper needed); see that file for details. -->

  <!-- Suction adhesion physics removed ahead of a presentation deadline
       to isolate and validate the tripod gait alone first; see chat
       history / prior world+launch files for the hexapod_link_attacher
       based version once gait is confirmed solid. -->

  <!-- Gazebo Classic does not reliably read URDF material/color tags
       (a well-documented limitation; it uses OGRE material scripts
       instead). The <material><color> tags on each link above are
       kept for RViz, which DOES read them; these <gazebo reference>
       blocks are what actually colors things in Gazebo itself. -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.03 0.03 0.03 1</ambient>
        <diffuse>0.03 0.03 0.03 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
      </material>
    </visual>
  </gazebo>
