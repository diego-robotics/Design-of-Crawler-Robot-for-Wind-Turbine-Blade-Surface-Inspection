    <origin xyz="-0.6002 -5.0825 0" rpy="1.5708 0 -1.064" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="1000.0" velocity="5" />
    <dynamics damping="5.0" friction="1.0" />
